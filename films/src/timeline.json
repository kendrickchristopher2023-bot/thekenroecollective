    {
      "id": "a01",
      "text": "Job hunting shouldn't mean rewriting yourself from scratch for every opening.",
      "file": "a01.mp3",
      "start": 0.0,
      "duration": 3.947,
      "captionEnd": 3.947,
      "sceneEnd": 4.347,
      "breathAfter": 0.4,
