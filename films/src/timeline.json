      "scene": "job search opening"
    },
    {
      "id": "a02",
      "text": "Application Kit finds real openings from public job boards, refreshed every day. Filter by place, remote or salary.",
      "file": "a02.mp3",
      "start": 4.347,
      "duration": 7.988,
      "captionEnd": 12.335,
      "sceneEnd": 12.735,
      "breathAfter": 0.4,
      "wpm": 135.2,
      "scene": "filters and updating results"
    },
    {
      "id": "a03",
      "text": "Paste a job description, and your résumé is rewritten in that role's language, with a cover letter drafted from what you've actually done.",
      "file": "a03.mp3",
      "start": 12.735,
      "duration": 7.477,
      "captionEnd": 20.212,
      "sceneEnd": 20.612,
      "breathAfter": 0.4,
      "wpm": 184.6,
      "scene": "job description and tailored résumé"
    },
    {
      "id": "a04",
      "text": "It never invents an employer, a title or a number.",
      "file": "a04.mp3",
      "start": 20.612,
      "duration": 3.622,
      "captionEnd": 24.234,
      "sceneEnd": 24.634,
      "breathAfter": 0.4,
      "wpm": 165.6,
      "scene": "original employer and title with tailored bullets"
    },
    {
      "id": "a05",
      "text": "Track every application, what came back and what's next, with interview prep and follow-ups ready.",
