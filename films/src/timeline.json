    {
      "id": "a01",
      "text": "Job hunting shouldn't mean rewriting yourself from scratch for every opening.",
      "file": "a01.mp3",
      "start": 0.0,
      "duration": 4.272,
      "captionEnd": 4.272,
      "sceneEnd": 4.672,
      "breathAfter": 0.4,
      "wpm": 154.5,
      "scene": "job search opening"
    },
    {
      "id": "a02",
      "text": "Application Kit finds real openings from public job boards, refreshed every day. Filter by place, remote or salary.",
      "file": "a02.mp3",
      "start": 4.672,
      "duration": 7.848,
      "captionEnd": 12.521,
      "sceneEnd": 12.921,
      "breathAfter": 0.4,
      "wpm": 137.6,
      "scene": "filters and updating results"
    },
    {
      "id": "a03",
      "text": "Paste a job description, and your r\u00e9sum\u00e9 is rewritten in that role's language, with a cover letter drafted from what you've actually done.",
      "file": "a03.mp3",
      "start": 12.921,
      "duration": 7.895,
      "captionEnd": 20.816,
      "sceneEnd": 21.216,
      "breathAfter": 0.4,
      "wpm": 174.8,
      "scene": "job description and tailored r\u00e9sum\u00e9"
    },
    {
      "id": "a04",
      "text": "It never invents an employer, a title or a number.",
      "file": "a04.mp3",
      "start": 21.216,
      "duration": 3.39,
      "captionEnd": 24.606,
      "sceneEnd": 25.006,
      "breathAfter": 0.4,
      "wpm": 177.0,
      "scene": "original employer and title with tailored bullets"
    },
    {
      "id": "a05",
      "text": "Track every application, what came back and what's next, with interview prep and follow-ups ready.",
